# brainstorming what the syntax should be #


#
object_t ->
    bool_t
    char_t
    number_t ->
        int_t
        float_t
        uint_t
        ufloat_t
    string_t
#


#inheritance determines its base value. for example, Object is empty (nothing) and is used only for reference casting, int is an integer value, etc.#
#classes only have#
class MyObject : object {
    var my_int int; # defaults to 0 #
    var my_int_referent int&; # defaults to null #
    var my_float float {0.1};
};


func gen_t<int_t>(gen_t<float_t>)(gen_t<float> x) {};

class gen_t<type : number_t> : object_t {
    var my_number_generic type; # defaults #
    var my_int_referent int&; # defaults to null, same as object_t by value and reference #
    var my_float float {0.1};
};


class my_int : int {
    var nanni float; # defaults to 0.0 #
};


class MyObjectInt : MyObject, my_int {
    var is_something bool {true};
};


func my_add int(my_int x) {
    return add<int>(x, cast<int>(x.nanni)); # x is int's value, x.nanni is my_int's nanni field #
};


func my_add_generic<type : number> type(type x) {
    return add<type>(x, cast<type>(x.nanni));
};


func my_add_2 int(MyObjectInt& x) {
    #& is the reference operator. x needs to be casted to my_int to get its value since it has multi-inheritance.#
    #not casting would result in the first inherited class (e.g., MyObject).#
    return add<int>(cast<my_int>(x), cast<int>(x.nanni));
};


while<bool<int>>(&is_less_than, x, size, int(){
    # & is the reference operator, also used when passing in as a reference parameter. #
    return assign<int>(&x, add<int>(x, 1));
});


func my_func bool(bool(int)& f, int x) {
    return f(x);
};


library MyLibrary {

    class MyObject : Object {
        int my_int; # defaults to 0 #
        float my_float {0.1};
    };

};


Library::MyObject my_lib_object {6, 2.5};

#these are containers, from the container library#

import<container>(); # built-in library #
import<MyLibrary>("path/to/my_library.koi"); # user-defined library #

container::array<int> my_array {3, 0, 4, 3};
container::set<int> my_set {0, 7, 3};
container::dictionary<container::pair<int, string>> my_dictionary {{1, "my key is 1"}, {4, "my key is 4"}};

container::get<container::array<int>>(&my_array, 1); # gets 4 or errors if out of range #
container::get<container::set<int>>(&my_set, 7); # gets 7 or errors #
container::get<container::dictionary<int>>(&my_dictionary, 4); # gets "my key is 4" or errors #
